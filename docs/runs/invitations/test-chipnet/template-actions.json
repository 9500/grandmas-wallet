{
  "$schema": "https://libauth.org/schemas/wallet-template-v0.schema.json",
  "name": "Grandma's Wallet actions",
  "description": "Payments from the wallet's addresses, addresses of an earlier seed, and vault addresses.",
  "version": "1",
  "supported": [
    "BCH_2026_05"
  ],
  "defaults": {
    "address": {
      "lockingScript": "earlierAddressLockingScript",
      "role": "owner",
      "variables": [
        {
          "keyHash": null
        },
        {
          "tag": null
        },
        {
          "identity": null
        },
        {
          "addressSecret": null
        }
      ]
    },
    "receive": {
      "output": "vaultOutput",
      "role": "owner",
      "variables": [
        {
          "tag": null
        },
        {
          "identity": null
        },
        {
          "addressSecret": null
        }
      ]
    }
  },
  "roles": {
    "owner": {
      "name": "Owner",
      "description": "Holds the wallet's seed and spends from it."
    }
  },
  "start": [
    {
      "action": "pay",
      "role": "owner"
    }
  ],
  "actions": {
    "pay": {
      "name": "Pay",
      "description": "Pay from the wallet's coins. The wallet names the coins and the outputs.",
      "roles": {
        "owner": {
          "requirements": {}
        }
      },
      "requirements": {
        "participants": [
          {
            "role": "owner",
            "slots": {
              "min": 1,
              "max": 1
            }
          }
        ]
      },
      "transaction": "payTransaction"
    }
  },
  "transactions": {
    "payTransaction": {
      "name": "Paid",
      "description": "Paid",
      "inputs": [],
      "outputs": [],
      "version": 2,
      "locktime": 0
    }
  },
  "inputs": {
    "sweptInput": {
      "name": "Coin of an earlier seed",
      "description": "Released through the controller with the owner's approval.",
      "unlockingScript": "unlockSweep"
    },
    "vaultInput": {
      "name": "Vault coin",
      "description": "Released through the controller with the owner's approval.",
      "unlockingScript": "unlockVault"
    }
  },
  "outputs": {
    "vaultOutput": {
      "name": "Vault address",
      "description": "Vault address",
      "lockingScript": "vaultLockingScript",
      "valueSatoshis": "1000"
    }
  },
  "lockingScripts": {
    "earlierAddressLockingScript": {
      "name": "Recoverable address of an earlier seed",
      "description": "The wallet's current owner moves it through the controller.",
      "lockingType": "p2sh",
      "lockingBytecode": "earlierAddressBytecode",
      "unlockingBytecode": "unlockSweep",
      "state": {
        "variables": [
          "keyHash",
          "tag",
          "identity",
          "addressSecret"
        ]
      },
      "roles": {
        "owner": {
          "balance": {
            "satoshis": true,
            "fungibleTokens": true,
            "nonfungibleTokens": true
          },
          "selectable": true,
          "actions": []
        }
      }
    },
    "vaultLockingScript": {
      "name": "Vault address",
      "description": "An address without a key: only the wallet's current owner spends from it, through the controller.",
      "lockingType": "p2sh",
      "lockingBytecode": "vaultBytecode",
      "unlockingBytecode": "unlockVault",
      "state": {
        "variables": [
          "tag",
          "identity",
          "addressSecret"
        ]
      },
      "roles": {
        "owner": {
          "balance": {
            "satoshis": true,
            "fungibleTokens": true,
            "nonfungibleTokens": true
          },
          "selectable": true,
          "actions": []
        }
      }
    }
  },
  "scripts": {
    "earlierAddressBytecode": "<keyHash> <tag> 0x5279009c635379a97b8872ac7777677b519d7b82012088537a820120887800ce78517e8800cf8201459d76517f75518800d17b517e8800d20201007b01317f75527f777e1400000000000000000000000000000000000000007e887eaa877768",
    "vaultBytecode": "<tag> 0x7c820120887b820120887800ce78517e8800cf8201459d76517f75518800d17b517e8800d20201007b01317f75527f777e1400000000000000000000000000000000000000007e887eaa87",
    "unlockSweep": "<addressSecret> <$(<identity> OP_REVERSEBYTES)> <1>",
    "unlockVault": "<addressSecret> <$(<identity> OP_REVERSEBYTES)>"
  },
  "variables": {
    "identity": {
      "name": "Wallet identity",
      "description": "The token category of the controller.",
      "type": "token_category"
    },
    "keyHash": {
      "name": "Key hash",
      "description": "The hash of the key an earlier seed made for this address.",
      "type": "bytes"
    },
    "tag": {
      "name": "Address tag",
      "description": "Ties the address to the wallet without showing which.",
      "type": "bytes"
    },
    "addressSecret": {
      "name": "Address secret",
      "description": "With the identity, what the controller path shows for this address.",
      "type": "bytes"
    }
  }
}

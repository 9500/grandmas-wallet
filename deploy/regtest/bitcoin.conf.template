# Bitcoin Cash Node as a local test chain (regtest), for rehearsing chain runs.
# Written to <folder>/node/bitcoin.conf by deploy/regtest/regtest.sh setup.
regtest=1
server=1
disablewallet=1
txindex=1
dbcache=50
maxmempool=50
listen=0
# The relay rules of the public networks, not the relaxed regtest default.
acceptnonstdtxn=0
[regtest]
rpcbind=127.0.0.1
rpcallowip=127.0.0.1
rpcport=@RPC_PORT@
rpcuser=regtest
rpcpassword=@PASSWORD@
zmqpubhashblock=tcp://127.0.0.1:@ZMQ_PORT@

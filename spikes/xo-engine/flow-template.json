{
 "$schema": "https://libauth.org/schemas/wallet-template-v0.schema.json",
 "name": "Recovery controller (spike)",
 "description": "Trial template for the Grandma's Wallet recovery controller.",
 "version": "0",
 "supported": [
  "BCH_2026_05"
 ],
 "roles": {
  "owner": {
   "name": "Owner",
   "description": "Controls the wallet in normal use."
  },
  "recoverer": {
   "name": "Recoverer",
   "description": "Can replace the owner after an unchallenged delay."
  }
 },
 "start": [
  {
   "action": "initialize",
   "role": "owner",
   "generate": [
    "ownerKey"
   ]
  }
 ],
 "actions": {
  "initialize": {
   "name": "Set up recovery",
   "description": "Set up recovery",
   "roles": {
    "owner": {
     "generate": [
      "ownerKey"
     ],
     "requirements": {
      "variables": [
       "identity",
       "ownerKeyHash",
       "recovererKeyHash",
       "walletSatoshis"
      ],
      "secrets": [
       "ownerKey"
      ]
     }
    }
   },
   "requirements": {
    "participants": [
     {
      "role": "owner",
      "slots": {
       "min": 1,
       "max": 1
      }
     }
    ]
   },
   "transaction": "initializeTransaction"
  },
  "send": {
   "name": "Send",
   "description": "Send",
   "roles": {
    "owner": {
     "generate": [
      "ownerKey"
     ],
     "requirements": {
      "variables": [
       "identity",
       "stateBody",
       "sentSatoshis",
       "recipientLockingScript"
      ],
      "secrets": [
       "ownerKey"
      ]
     }
    }
   },
   "requirements": {
    "participants": [
     {
      "role": "owner",
      "slots": {
       "min": 1,
       "max": 1
      }
     }
    ]
   },
   "transaction": "sendTransaction"
  },
  "requestRecovery": {
   "name": "Request recovery",
   "description": "Request recovery",
   "roles": {
    "recoverer": {
     "generate": [
      "recovererKey"
     ],
     "requirements": {
      "variables": [
       "identity",
       "stateBody",
       "proposedOwnerKeyHash"
      ],
      "secrets": [
       "recovererKey"
      ]
     }
    }
   },
   "requirements": {
    "participants": [
     {
      "role": "recoverer",
      "slots": {
       "min": 1,
       "max": 1
      }
     }
    ]
   },
   "transaction": "requestRecoveryTransaction"
  },
  "finalizeRecovery": {
   "name": "Finalize recovery",
   "description": "Finalize recovery",
   "roles": {
    "recoverer": {
     "generate": [
      "recovererKey"
     ],
     "requirements": {
      "variables": [
       "identity",
       "finalizedState",
       "challengeSequence"
      ],
      "secrets": [
       "recovererKey"
      ]
     }
    }
   },
   "requirements": {
    "participants": [
     {
      "role": "recoverer",
      "slots": {
       "min": 1,
       "max": 1
      }
     }
    ]
   },
   "transaction": "finalizeRecoveryTransaction"
  }
 },
 "transactions": {
  "initializeTransaction": {
   "name": "Recovery set up",
   "description": "Recovery set up",
   "inputs": [],
   "outputs": [
    {
     "output": "initialControllerOutput",
     "outputIndex": 0
    },
    {
     "output": "walletOutput"
    }
   ],
   "version": 2,
   "locktime": 0
  },
  "sendTransaction": {
   "name": "Sent",
   "description": "Sent",
   "inputs": [
    {
     "input": "controllerOwnerInput",
     "inputIndex": 0
    },
    {
     "input": "walletInput"
    }
   ],
   "outputs": [
    {
     "output": "activeControllerOutput",
     "outputIndex": 0
    },
    {
     "output": "paymentOutput"
    }
   ],
   "version": 2,
   "locktime": 0
  },
  "requestRecoveryTransaction": {
   "name": "Recovery requested",
   "description": "Recovery requested",
   "inputs": [
    {
     "input": "controllerClaimInput",
     "inputIndex": 0
    }
   ],
   "outputs": [
    {
     "output": "pendingControllerOutput",
     "outputIndex": 0
    }
   ],
   "version": 2,
   "locktime": 0
  },
  "finalizeRecoveryTransaction": {
   "name": "Recovery finalized",
   "description": "Recovery finalized",
   "inputs": [
    {
     "input": "controllerFinalizeInput",
     "inputIndex": 0
    }
   ],
   "outputs": [
    {
     "output": "finalizedControllerOutput",
     "outputIndex": 0
    }
   ],
   "version": 2,
   "locktime": 0
  }
 },
 "inputs": {
  "controllerOwnerInput": {
   "name": "Controller",
   "description": "Controller",
   "unlockingScript": "unlockOwnerAuthorize"
  },
  "controllerClaimInput": {
   "name": "Controller",
   "description": "Controller",
   "unlockingScript": "unlockRequestRecovery"
  },
  "controllerFinalizeInput": {
   "name": "Controller",
   "description": "Controller",
   "unlockingScript": "unlockFinalizeRecovery",
   "sequenceNumber": "$(<challengeSequence>)"
  },
  "walletInput": {
   "name": "Wallet funds",
   "description": "Wallet funds",
   "unlockingScript": "unlockAsset"
  }
 },
 "outputs": {
  "initialControllerOutput": {
   "name": "Controller",
   "description": "Controller",
   "lockingScript": "controllerLockingScript",
   "valueSatoshis": "1000",
   "token": {
    "category": "$(<identity>)",
    "amount": null,
    "nft": {
     "capability": "mutable",
     "commitment": "$(<\"010000000000\"> <ownerKeyHash> OP_CAT <recovererKeyHash> OP_CAT <\"0100400000000000000000000000000000000000000000\"> OP_CAT)"
    }
   }
  },
  "activeControllerOutput": {
   "name": "Controller",
   "description": "Controller",
   "lockingScript": "controllerLockingScript",
   "valueSatoshis": "1000",
   "token": {
    "category": "$(<identity>)",
    "amount": null,
    "nft": {
     "capability": "mutable",
     "commitment": "$(<\"0100\"> <stateBody> OP_CAT <\"0000000000000000000000000000000000000000\"> OP_CAT)"
    }
   }
  },
  "pendingControllerOutput": {
   "name": "Controller",
   "description": "Controller",
   "lockingScript": "controllerLockingScript",
   "valueSatoshis": "1000",
   "token": {
    "category": "$(<identity>)",
    "amount": null,
    "nft": {
     "capability": "mutable",
     "commitment": "$(<\"0101\"> <stateBody> OP_CAT <proposedOwnerKeyHash> OP_CAT)"
    }
   }
  },
  "finalizedControllerOutput": {
   "name": "Controller",
   "description": "Controller",
   "lockingScript": "controllerLockingScript",
   "valueSatoshis": "1000",
   "token": {
    "category": "$(<identity>)",
    "amount": null,
    "nft": {
     "capability": "mutable",
     "commitment": "$(<finalizedState>)"
    }
   }
  },
  "walletOutput": {
   "name": "Wallet funds",
   "description": "Wallet funds",
   "lockingScript": "assetLockingScript",
   "valueSatoshis": "$(<walletSatoshis>)",
   "token": null
  },
  "paymentOutput": {
   "name": "Payment",
   "description": "Payment",
   "lockingScript": "$(<recipientLockingScript>)",
   "valueSatoshis": "$(<sentSatoshis>)"
  }
 },
 "lockingScripts": {
  "controllerLockingScript": {
   "name": "Recovery controller",
   "description": "Recovery controller",
   "lockingType": "p2sh",
   "lockingBytecode": "controllerBytecode",
   "state": {
    "variables": [
     "identity"
    ]
   },
   "roles": {
    "owner": {
     "state": {
      "secrets": [
       "ownerKey"
      ]
     },
     "actions": [
      {
       "action": "send",
       "role": "owner",
       "secrets": [
        {
         "ownerKey": null
        }
       ]
      }
     ]
    },
    "recoverer": {
     "state": {
      "secrets": [
       "recovererKey"
      ]
     },
     "actions": [
      {
       "action": "requestRecovery",
       "role": "recoverer",
       "secrets": [
        {
         "recovererKey": null
        }
       ]
      },
      {
       "action": "finalizeRecovery",
       "role": "recoverer",
       "secrets": [
        {
         "recovererKey": null
        }
       ]
      }
     ]
    }
   }
  },
  "assetLockingScript": {
   "name": "Wallet funds",
   "description": "Wallet funds",
   "lockingType": "p2sh",
   "lockingBytecode": "assetBytecode",
   "state": {
    "variables": [
     "identity"
    ]
   },
   "roles": {
    "owner": {
     "state": {
      "secrets": [
       "ownerKey"
      ]
     },
     "balance": {
      "satoshis": true,
      "fungibleTokens": true,
      "nonfungibleTokens": true
     },
     "selectable": true
    }
   }
  }
 },
 "scripts": {
  "controllerBytecode": "<$(<identity> OP_REVERSEBYTES)> ",
  "assetBytecode": "<$(<identity> OP_REVERSEBYTES)> 0x78537900ce5379517e8800cf8201459d76517f7551887ba978011a7f75567f7788787b82778c7f7701618800d17b517e8800d20201007b01317f75527f777e1400000000000000000000000000000000000000007e88ac",
  "unlockOwnerAuthorize": "<ownerKey.schnorr_signature.all_outputs_all_utxos> <ownerKey.public_key> <0>",
  "unlockRequestRecovery": "<proposedOwnerKeyHash> <recovererKey.schnorr_signature.all_outputs_all_utxos> <recovererKey.public_key> <1>",
  "unlockFinalizeRecovery": "<recovererKey.schnorr_signature.all_outputs_all_utxos> <recovererKey.public_key> <2>",
  "unlockAsset": "<ownerKey.schnorr_signature.all_outputs_all_utxos> <ownerKey.public_key>"
 },
 "variables": {
  "ownerKey": {
   "name": "Owner key",
   "description": "Owner key",
   "type": "private_key"
  },
  "recovererKey": {
   "name": "Recoverer key",
   "description": "Recoverer key",
   "type": "private_key"
  },
  "identity": {
   "name": "Wallet identity",
   "description": "Wallet identity",
   "type": "token_category"
  },
  "ownerKeyHash": {
   "name": "Owner key hash",
   "description": "Owner key hash",
   "type": "bytes"
  },
  "recovererKeyHash": {
   "name": "Recoverer key hash",
   "description": "Recoverer key hash",
   "type": "bytes"
  },
  "proposedOwnerKeyHash": {
   "name": "Proposed owner key hash",
   "description": "Proposed owner key hash",
   "type": "bytes"
  },
  "stateBody": {
   "name": "Current controller state",
   "description": "Current controller state",
   "type": "bytes"
  },
  "finalizedState": {
   "name": "Controller state after recovery",
   "description": "Controller state after recovery",
   "type": "bytes"
  },
  "challengeSequence": {
   "name": "Challenge delay sequence number",
   "description": "Challenge delay sequence number",
   "type": "integer"
  },
  "walletSatoshis": {
   "name": "Initial wallet funds",
   "description": "Initial wallet funds",
   "type": "satoshis"
  },
  "sentSatoshis": {
   "name": "Amount to send",
   "description": "Amount to send",
   "type": "satoshis"
  },
  "recipientLockingScript": {
   "name": "Recipient",
   "description": "Recipient",
   "type": "locking_script"
  }
 }
}
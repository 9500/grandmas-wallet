pragma cashscript ^0.14.0;

// Savings Jar for an ordinary wallet: funds locked to one of the wallet's
// keys until `unlockTime`.
//
// Deposits are ordinary payments to the jar's address. After the unlock
// time, a signature from the key empties the jar. Nothing else can.
//
// A withdrawing transaction needs a locktime at or after `unlockTime` and a
// non-final sequence number on the jar input.
contract KeyJar(bytes20 ownerKeyHash, int unlockTime) {
    function withdraw(pubkey ownerKey, sig ownerSignature) {
        require(hash160(ownerKey) == ownerKeyHash);
        require(checkSig(ownerSignature, ownerKey));
        require(tx.time >= unlockTime);
    }
}

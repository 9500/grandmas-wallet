pragma cashscript ^0.14.0;

// Grandma's Wallet shared authorization interface, v1.
//
// A protected output (an asset or an application position) is bound to a
// wallet identity: the token category of the wallet's controller. It may only
// be spent in a transaction in which the current owner of that identity
// approves, which this function checks from the protected input's side.
//
// Transaction layout:
//   Inputs:  00-controller, 01+ protected inputs and anything else
//   Outputs: 00-controller, 01+ anything
//
// The presence of the controller is not treated as approval. The recoverer
// can also spend the controller, to open or complete a recovery claim, so a
// protected input additionally requires:
//   - a signature by the owner recorded in the controller state being spent,
//     covering the whole transaction, and
//   - a controller successor that keeps that same owner, epoch, recoverer and
//     delay with no claim pending. Recovery claims and completions never
//     produce such a successor.
//
// The caller must verify the signature itself with checkSig(ownerSig, ownerPk).
function ownerApproves(bytes32 identity, pubkey ownerPk, sig ownerSig) {
    // The genuine controller: the identity NFT with mutable capability.
    require(tx.inputs[0].tokenCategory == identity + 0x01);

    bytes state = tx.inputs[0].nftCommitment;
    require(state.length == 69);
    require(state.split(1)[0] == 0x01);

    require(hash160(ownerPk) == state.slice(6, 26));
    // SIGHASH_ALL | SIGHASH_UTXOS | SIGHASH_FORKID
    require(bytes(ownerSig).split(bytes(ownerSig).length - 1)[1] == 0x61);

    require(tx.outputs[0].tokenCategory == identity + 0x01);
    require(
        tx.outputs[0].nftCommitment ==
            0x0100 + state.slice(2, 49) + 0x0000000000000000000000000000000000000000
    );
}

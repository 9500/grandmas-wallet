pragma cashscript ^0.14.0;

import "./lib/authorization.cash";

// Grandma's Wallet asset covenant.
//
// Holds BCH, fungible tokens or an NFT for the wallet identified by
// `identity`. Its address is the wallet's receiving address and stays the
// same when the owner key is replaced.
//
// Transaction layout:
//   Inputs:  00-controller, 01+ assets and anything else
//   Outputs: 00-controller, 01+ anything
//
// Outputs are not restricted here: the owner's signature on the controller
// covers every output, and the wallet decides where payments and change go.
contract Asset(bytes32 identity) {
    function spend() {
        ownerApproves(identity);
        // The controller enforces this as well; the compiler needs a function to end on a check of its own.
        require(tx.version == 2);
    }
}

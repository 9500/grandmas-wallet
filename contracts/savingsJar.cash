pragma cashscript ^0.14.0;

import "./lib/authorization.cash";

// Savings Jar: a demonstration application position.
//
// Funds paid to the jar stay locked until `unlockTime`. After that, the
// current owner of the wallet identified by `identity` can withdraw them.
// Replacing the owner key, including through recovery, changes who can
// withdraw but never when.
//
// Deposits are ordinary payments to the jar's address.
//
// Transaction layout for withdraw:
//   Inputs:  00-controller, 01+ jars and anything else
//   Outputs: 00-controller, 01+ anything
contract SavingsJar(bytes32 identity, int unlockTime) {
    function withdraw() {
        ownerApproves(identity);
        require(tx.time >= unlockTime);
    }
}
